* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.dll binary
*.exe binary
*.ico binary
*.lib binary
*.moc3 binary
*.png binary
*.webp binary

# Preserve hash-bound upstream licensing/provenance bytes through Git checkout.
# Authored documentation and collection scripts retain normal repository rules.
runtime-rs/native-licenses/** -text
runtime-rs/native-licenses/README.md text eol=lf
runtime-rs/native-licenses/.gitignore text eol=lf
runtime-rs/native-licenses/collect-sources.ps1 text eol=crlf
