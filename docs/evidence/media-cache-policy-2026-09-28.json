  "scope": "Simulation of cache membership and misses using std HashMap<PathBuf,u64>. No media files, SHA-256 calls, filesystem identities, production workspace, model, or device workload are exercised.",
  "metric": "simulated cache misses and hits; not actual media digest invocations, CPU time, memory, or end-to-end throughput",
  "capacity": 256,
  "sampleCountPerScenarioAndStrategy": 20,
  "hashSeeding": "Twenty fresh std RandomState seeds per scenario, each cloned across all three policies for a paired comparison. Raw seed bytes are private to std and cannot be serialized. Sample array positions identify paired seeds; a rerun creates fresh seeds.",
  "medianDefinition": "Arithmetic mean of sorted sample indices 9 and 10 (zero-based), recomputed from this run.",
  "commonRules": "Empty cache initially for every strategy/sample; each path represents one unchanged valid identity; every miss inserts one entry; no allocation reservation. Path format workspace/media/objects/{id modulo 256 in 2-digit hexadecimal}/{id in 64-digit hexadecimal}.",
  "policies": {
    "current_arbitrary": "On full miss evict HashMap.keys().next(); hits do not affect eviction. Tick metadata in this fixture is ignored by eviction.",
    "lru": "On hit/insert record request tick; on full miss evict minimum tick, scanning at most 256 entries.",
    "lfu_age1024": "Insert at count 1; hit increments count with saturating_add; before request ticks 1024,2048,... halve each count with integer division and floor 1. On full miss evict minimum count; ties follow current HashMap iteration order."
  },
