{
  "name": "huiyu",
  "version": "1.7.1",
  "private": true,
  "author": "绘遇 HUIYU",
  "description": "个人使用的 Galgame 风格 AI CG 场景工作台与 SD WebUI / ComfyUI (Anima/Krea/Wan/H3) 网关",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "postinstall": "node scripts/build-node.mts && node scripts/maintenance/install-git-hooks.js",
    "prestart": "npm run build:runtime",
    "start": "node server.js",
    "dev": "vite",
    "prebuild": "npm run build:runtime",
    "build": "vite build && node scripts/maintenance/check-bundle-budget.js && node scripts/maintenance/precompress.js",
    "build:analyze": "vite build --mode analyze && node scripts/maintenance/check-bundle-budget.js",
    "build:all": "npm run build && npm run build:runtime",
    "prod": "npm run build && npm start",
    "dev:server": "node scripts/dev-server.mts",
    "typecheck:app": "vue-tsc -p tsconfig.app.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "typecheck:browser-tools": "node scripts/build-node.mts --project browser --check",
    "precheck": "npm run build:runtime",
    "check": "node scripts/maintenance/run-check-parallel.js",
    "test:check": "node scripts/tests/test-quality-gates.js && node scripts/tests/run-quality-suite.js check",
    "test:desktop:native": "node scripts/tests/run-desktop-native-acceptance.js",
    "test:frontend": "vitest run",
    "pretest:unit": "npm run build:runtime",
    "test:unit": "node scripts/tests/run-quality-suite.js unit",
    "pretest:contract": "npm run build:runtime",
    "test:contract": "node scripts/tests/run-quality-suite.js contract",
    "validate": "npm run check && npm run test:frontend && npm run test:unit && npm run test:contract",
    "design:lint": "designmd lint DESIGN.md",
    "build:runtime": "node scripts/build-node.mts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.runtime.json --noEmit && npm run typecheck:node && npm run typecheck:tests && npm run typecheck:browser-tools",
    "test:voice-baseline": "node scripts/tests/test-voice-baseline.js",
    "test:voice-profile": "node scripts/tests/test-voice-profile-contract.js",
    "test:ux": "node scripts/tests/test-scene-ux.js",
    "test:quick": "node scripts/tests/test-quick-create.js",
    "test:sd-errors": "node scripts/tests/test-sd-error.js",
    "test:generation": "node scripts/tests/test-generation-routes.js",
    "test:backup": "node scripts/tests/test-data-backup.js",
    "backup:git": "node scripts/maintenance/git-bundle-backup.js",
    "release:desktop": "node scripts/maintenance/release-desktop-update.js",
    "test:storage-health": "node scripts/tests/test-storage-health.js",
    "test:security": "node scripts/tests/test-security.js && node scripts/tests/test-gateway-contract.js",
    "test:gateway": "node scripts/tests/test-gateway-contract.js",
    "test:comfy-progress": "node --test scripts/tests/test-comfy-progress.js",
    "test:gateway-token": "node scripts/tests/test-gateway-token.js",
    "test:prompt-builder": "node scripts/tests/test-prompt-builder-modules.js",
    "test:prompt-policy": "node scripts/tests/test-prompt-policy.js",
    "test:rewrite-integrity": "node scripts/tests/test-prompt-rewrite-integrity.js",
    "test:showcase": "node scripts/tests/test-showcase.js",
    "test:gallery": "node scripts/tests/test-gallery.js",
    "test:architecture": "node scripts/tests/test-page-architecture.js",
    "test:monolith": "node scripts/tests/test-monolith-budget.js",
    "test:style-debt": "node scripts/tests/test-style-debt.js && node scripts/maintenance/scan-style-literals.js --check && node scripts/maintenance/check-contrast.js --check && node scripts/maintenance/lint-colors.js --check && node scripts/maintenance/lint-animations.js --check",
    "test:a11y-labels": "node scripts/tests/test-icon-button-labels.js",
    "lint:literals": "node scripts/maintenance/scan-style-literals.js",
    "lint:js": "eslint src routes services scripts server.ts server tools",
    "lint:js:fix": "eslint src routes services scripts server.ts server tools --fix",
    "lint:contrast": "node scripts/maintenance/check-contrast.js",
    "lint:animations": "node scripts/maintenance/lint-animations.js",
    "test:control-operation": "node scripts/tests/test-control-operation.js",
    "test:control-failures": "node scripts/tests/test-control-failure-contract.js",
    "test:serial-queue": "node scripts/tests/test-serial-queue.js",
    "test:http-client": "node scripts/tests/test-http-client.js",
    "test:live2d": "node scripts/tests/test-live2d-service.js",
    "test:live2d-backend": "node scripts/tests/test-live2d-backend.js",
    "test:live2d-native": "node scripts/tests/run-live2d-selftest.js --release",
    "test:live2d-native:release": "node scripts/tests/run-live2d-selftest.js --release",
    "test:live": "npm run test:voice-emotions:live && npm run test:chat-voice:live && node scripts/tests/regress-anima-prompt-tags.js && npm run test:live2d-native:release",
    "test:repo-hygiene": "node scripts/tests/test-repo-hygiene.js && node scripts/tests/test-repo-hygiene-contract.js",
    "test:services-generated": "node scripts/tests/test-runtime-generated.js",
    "test:desktop-staging": "node scripts/tests/test-desktop-staging.js",
    "prepare:tauri": "node scripts/maintenance/prepare-tauri.js",
    "dev:tauri": "node scripts/maintenance/run-tauri.js dev",
    "build:tauri": "node scripts/maintenance/run-tauri.js build --no-bundle --ci",
    "package:tauri": "node scripts/maintenance/run-tauri.js build --ci --no-sign --bundles nsis",
    "test:content": "node scripts/maintenance/validate-content-contracts.js",
    "patch:scenes": "node scripts/maintenance/apply-scene-patch.js",
    "test:voice-quality": "node scripts/tests/test-wav-quality.js",
    "test:voice-emotions:live": "node scripts/maintenance/regress-voice-emotions.js",
    "test:chat-voice:live": "node scripts/maintenance/regress-chat-voice-live.mjs",
    "test:e2e": "npm run build && npm run test:e2e:all",
    "test:e2e:all": "playwright test",
    "test:e2e:critical": "npm run build && npm run test:e2e:critical:run",
    "test:e2e:critical:run": "playwright test tests/e2e/studio.spec.ts tests/e2e/flows.spec.ts tests/e2e/a11y-device.spec.ts tests/e2e/anima-quick.spec.ts tests/e2e/interaction-polish.spec.ts tests/e2e/ui-layout.spec.ts tests/e2e/companion-focus.spec.ts tests/e2e/office-code.spec.ts tests/e2e/library-concurrency.spec.ts tests/e2e/workbench-loading.spec.ts",
    "test:e2e:performance": "playwright test --config=playwright.performance.config.ts",
    "test:e2e:nightly": "npm run build && npm run test:e2e:nightly:run",
    "test:e2e:nightly:run": "playwright test tests/e2e/theme-audit.spec.ts tests/e2e/capture.spec.ts tests/e2e/particle-atmosphere.spec.ts tests/e2e/particle-narrative.spec.ts tests/e2e/archive-visual-language.spec.ts",
    "test:maintenance": "node scripts/tests/test-maintenance.js",
    "test:chat": "node scripts/tests/test-chat.js",
    "test:chat-storage": "node scripts/tests/test-chat-storage.js",
    "test:resource": "node scripts/tests/test-resource-scheduling.js",
    "benchmark:voice": "node scripts/maintenance/benchmark-voice.js",
    "benchmark:voice-baseline": "node scripts/maintenance/check-voice-baseline.js",
    "audit:prompts": "node scripts/maintenance/audit-prompts.js",
    "workflow": "node scripts/workflow.js",
    "wf": "node scripts/workflow.js",
    "office:health": "node scripts/maintenance/office-health.js",
    "scenes:build": "node scripts/maintenance/build-scenes.js",
    "scenes:pin": "node scripts/maintenance/pin-scene-prompts.js --check",
    "scenes:pin-capture": "node scripts/maintenance/pin-scene-prompts.js --capture",
    "particles:build": "python scripts/maintenance/build-particle-portraits.py",
    "character:onboard": "node scripts/maintenance/workflow-onboard-popular-character.js",
    "scenes:import": "node scripts/maintenance/split-scenes.js --write && node scripts/maintenance/build-scenes.js",
    "popular:build": "node scripts/maintenance/build-popular.js",
    "popular:split": "node scripts/maintenance/split-popular.js --write",
    "popular:import": "node scripts/maintenance/split-popular.js --write && node scripts/maintenance/build-popular.js",
    "blueprints:build": "node scripts/maintenance/build-blueprints.js",
    "blueprints:split": "node scripts/maintenance/split-blueprints.js --write",
    "blueprints:import": "node scripts/maintenance/split-blueprints.js --write && node scripts/maintenance/build-blueprints.js",
    "scenes:normalize": "node scripts/maintenance/classify-scene-ratings.js --write && node scripts/maintenance/optimize-scenes.js --write && node scripts/maintenance/validate-scenes.js",
    "optimize-scenes": "node scripts/maintenance/optimize-scenes.js --write",
    "classify-ratings": "node scripts/maintenance/classify-scene-ratings.js --write",
    "lint:colors": "node scripts/maintenance/lint-colors.js",
    "precompress": "node scripts/maintenance/precompress.js",
    "test:ux-regressions": "node scripts/tests/test-ux-regressions.js"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@soullink-emotion/engine": "^0.1.0-beta.1",
    "@vueuse/core": "^14.4.0",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "motion": "^12.43.0",
    "onnxruntime-node": "^1.29.0",
    "pinia": "^4.0.2",
    "sharp": "^0.35.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "wl-live2d": "^1.0.8",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google/design.md": "^0.3.0",
    "@playwright/test": "^1.62.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "ajv": "^8.20.0",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "vue-tsc": "3.3.8"
  },
  "overrides": {
    "pixi-live2d-display": {
      "gh-pages": "^6.3.0"
    }
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 113",
    "safari >= 16.4"
  ]
}
