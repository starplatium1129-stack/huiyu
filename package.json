{
  "name": "huiyu",
  "version": "2.0.0",
  "private": true,
  "author": "绘遇 HUIYU",
  "description": "个人使用的 Galgame 风格 AI CG 场景工作台与 SD WebUI / ComfyUI (Anima/Krea/Wan/H3) 网关",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "postinstall": "node scripts/build-node.mts && node scripts/maintenance/install-git-hooks.js",
    "prestart": "npm run build:runtime",
    "start": "node scripts/maintenance/run-rust-runtime.js start",
    "start:run": "node scripts/maintenance/run-rust-runtime.js start",
    "dev": "vite",
    "prebuild": "npm run build:runtime",
    "build:web:run": "vite build && node scripts/maintenance/check-bundle-budget.js && node scripts/maintenance/precompress.js",
    "build": "npm run build:web:run",
    "build:analyze": "vite build --mode analyze && node scripts/maintenance/check-bundle-budget.js",
    "prod": "npm run build && npm run start:run",
    "dev:server": "node scripts/dev-server.mts",
    "rust:build:dev": "node scripts/maintenance/run-rust-runtime.js build-dev",
    "start:dev": "node scripts/maintenance/run-rust-runtime.js start-dev",
    "typecheck:app": "vue-tsc -p tsconfig.app.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:browser-tools": "node scripts/build-node.mts --project browser --check",
    "design:lint": "designmd lint DESIGN.md",
    "build:runtime": "node scripts/build-node.mts",
    "typecheck": "npm run typecheck:app && npm run typecheck:node && npm run typecheck:browser-tools",
    "backup:git": "node scripts/maintenance/git-bundle-backup.js",
    "prerelease:desktop": "npm run build:runtime",
    "release:desktop": "node scripts/maintenance/release-desktop-update.js",
    "lint:literals": "node scripts/maintenance/scan-style-literals.js",
    "lint:js": "eslint src scripts tools",
    "lint:js:fix": "eslint src scripts tools --fix",
    "lint:contrast": "node scripts/maintenance/check-contrast.js",
    "lint:animations": "node scripts/maintenance/lint-animations.js",
    "prepare:tauri": "node scripts/maintenance/prepare-tauri.js",
    "dev:tauri": "node scripts/maintenance/run-tauri.js dev",
    "prebuild:tauri": "npm run build:runtime",
    "build:tauri": "node scripts/maintenance/run-tauri.js build --no-bundle --ci",
    "prepackage:tauri": "npm run build:runtime",
    "package:tauri": "node scripts/maintenance/run-tauri.js build --ci --no-sign --bundles nsis",
    "legacy:scenes:patch": "node scripts/maintenance/apply-scene-patch.js",
    "audit:prompts": "node scripts/maintenance/audit-prompts.js",
    "workflow": "node scripts/workflow.js",
    "wf": "node scripts/workflow.js",
    "office:health": "node scripts/maintenance/office-health.js",
    "scenes:build": "node scripts/maintenance/build-scenes.js",
    "scenes:pin": "node scripts/maintenance/pin-scene-prompts.js --check",
    "scenes:pin-capture": "node scripts/maintenance/pin-scene-prompts.js --capture",
    "particles:build": "python scripts/maintenance/build-particle-portraits.py",
    "character:onboard": "node scripts/maintenance/workflow-onboard-popular-character.js",
    "legacy:scenes:import": "node scripts/maintenance/split-scenes.js --write && node scripts/maintenance/build-scenes.js",
    "popular:build": "node scripts/maintenance/build-popular.js",
    "legacy:popular:split": "node scripts/maintenance/split-popular.js --write",
    "legacy:popular:import": "node scripts/maintenance/split-popular.js --write && node scripts/maintenance/build-popular.js",
    "blueprints:build": "node scripts/maintenance/build-blueprints.js",
    "legacy:blueprints:split": "node scripts/maintenance/split-blueprints.js --write",
    "legacy:blueprints:import": "node scripts/maintenance/split-blueprints.js --write && node scripts/maintenance/build-blueprints.js",
    "tags:build": "node scripts/maintenance/build-tags.js",
    "tags:check": "node scripts/maintenance/build-tags.js --check",
    "legacy:tags:split": "node scripts/maintenance/split-tags.js --write",
    "legacy:tags:import": "node scripts/maintenance/split-tags.js --write && node scripts/maintenance/build-tags.js",
    "legacy:scenes:normalize": "node scripts/maintenance/classify-scene-ratings.js --write && node scripts/maintenance/optimize-scenes.js --write && node scripts/maintenance/validate-scenes.js",
    "lint:colors": "node scripts/maintenance/lint-colors.js",
    "precompress": "node scripts/maintenance/precompress.js"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@soullink-emotion/engine": "0.1.0-beta.1",
    "@tanstack/vue-virtual": "3.13.39",
    "@vueuse/core": "^14.4.0",
    "motion": "^12.43.0",
    "photoswipe": "5.4.4",
    "pinia": "^4.0.2",
    "pixi-live2d-display": "file:vendor/pixi-live2d-display",
    "reka-ui": "2.10.4",
    "vue": "3.5.43",
    "vue-router": "^4.5.0",
    "wl-live2d": "^1.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google/design.md": "^0.3.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.0",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "6.0.9",
    "ajv": "^8.20.0",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "postcss": "8.5.23",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "8.3.1",
    "vue-tsc": "3.3.8"
  },
  "overrides": {
    "pixi-live2d-display": "$pixi-live2d-display"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4"
  ]
}
