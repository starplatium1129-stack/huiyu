{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Desktop shell commands exposed only to the bundled loopback gateway UI.",
  "windows": ["companion", "companion-chat", "atelier"],
  "remote": {
    "urls": ["http://127.0.0.1:*/*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "global-shortcut:default",
    "notification:default",
    "dialog:default",
    "autostart:default",
    "opener:default",
    "allow-get-state",
    "allow-hide",
    "allow-quit",
    "allow-set-ignore-mouse-events-cmd",
    "allow-toggle-ignore-mouse-events",
    "allow-toggle-always-on-top",
    "allow-set-live2d-enabled",
    "allow-get-settings",
    "allow-set-autostart",
    "allow-is-packaged",
    "allow-get-workspace",
    "allow-set-workspace",
    "allow-notify",
    "allow-open-atelier",
    "allow-open-companion-chat",
    "allow-toggle-companion-chat",
    "allow-hide-companion-chat",
    "allow-set-chat-docked",
    "allow-get-chat-docked",
    "allow-chat-relay",
    "allow-window-minimize",
    "allow-window-maximize-toggle",
    "allow-window-close",
    "allow-get-window-state",
    "allow-window-zoom-get",
    "allow-window-zoom-set",
    "allow-set-progress",
    "allow-open-workspace",
    "allow-open-runtime",
    "allow-open-log",
    "allow-pick-files",
    "allow-save-image",
    "allow-desktop-update-check",
    "allow-desktop-update-install"
  ]
}
