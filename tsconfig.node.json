{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmitOnError": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".",
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "types": ["node"]
  },
  "include": [
    "server.ts",
    "server/**/*.ts",
    "routes/**/*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "poc/**/*.mts",
    "poc/**/*.cts",
    "poc/**/*.ts",
    "eslint.config.mts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts/archive",
    "scripts/tests",
    "scripts/maintenance/ui-shots",
    "scripts/**/*.d.ts"
  ]
}
