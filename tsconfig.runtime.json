{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "strict": true,
    "noEmitOnError": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "services",
    "outDir": "services",
    "types": ["node"]
  },
  "include": ["services/**/*.ts"],
  "exclude": ["services/**/*.js", "services/**/*.d.ts"]
}
